// 이 파일을 Config/Secrets.xcconfig로 복사하고 값을 채운다(Secrets.xcconfig는 git에 올리지 않는다).
// `//`가 주석으로 잘리지 않도록 빈 확장 $()로 나눈다.
// 서버 origin. mock 서버 E2E(DEBUG 빌드)는 http:/$()/localhost:4010
API_BASE_URL = https:/$()/chalkak-dev.pysun.kr
// Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY = <카카오 네이티브 앱 키>
// 스토어에 등록된 앱이 생기면 YES와 URL을 채운다.
// FORCE_UPDATE_ENABLED = YES
// APP_STORE_URL = https:/$()/apps.apple.com/kr/app/id0000000000
