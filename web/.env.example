# 서버 origin만 적는다(경로 없음). 앱이 /api/v1 을 붙인다. 비우거나 same-origin 이면 현재 페이지 출처를 쓰고 Vite 프록시를 거친다. 허용: https, loopback(localhost, 127.0.0.1)의 http.
VITE_API_BASE_URL=
# dev·preview 프록시가 넘길 실제 서버. mock 서버로 바꿀 때 이 값만 바꾼다.
PROXY_TARGET=https://chalkak-dev.pysun.kr
# 카카오 로그인(OIDC 인가 리다이렉트)용 앱 키. 서버가 웹 키 aud를 받아 주는지는 Q-02 결론 전이라 개발 서버 E2E는 세션 주입(VITE_ENABLE_DEV_SESSION)을 쓴다.
VITE_KAKAO_CLIENT_ID=
# 'true'면 프로덕션 모드 빌드에서도 /dev/session(개발용 세션 주입)이 켜진다. 배포 빌드에서는 비워 둔다.
VITE_ENABLE_DEV_SESSION=
# 'true'면 presigned PUT(사인·사진)을 같은 출처 /__upload-proxy/<S3 호스트>/... 로 보내 dev·preview 서버가 S3로 넘긴다(버킷 CORS 회피). 개발 서버(npm run dev)는 비워도 켜진다. 배포 빌드에서는 비워 둔다.
VITE_UPLOAD_PROXY=
# 프록시가 amazonaws.com·loopback 외에 허용할 업로드 호스트(쉼표 구분). 보통 비운다.
UPLOAD_PROXY_ALLOWED_HOSTS=
# 프록시가 허용할 loopback(http) 업로드 포트(쉼표 구분). 기본 4010.
UPLOAD_PROXY_ALLOWED_LOOPBACK_PORTS=
