# 로컬 실행용 예시. 복사해서 .env로 쓰거나 셸에서 직접 지정한다.
# 서버 origin만 적는다(/api/v1은 앱이 붙인다). 기본값은 없으며, 비어 있으면 설정 오류 화면이 뜬다.
API_BASE_URL=https://chalkak-dev.pysun.kr

# 카카오 네이티브 앱 키(Kakao Developers > 앱 키). 값은 커밋하지 않는다. 없으면 카카오 로그인이 설정 오류로 끝난다.
KAKAO_NATIVE_APP_KEY=
# 강제 업데이트 조회(기본 꺼짐). true일 때만 켠다.
FORCE_UPDATE_CHECK_ENABLED=
# App Store 앱 숫자 id(강제 업데이트 다이얼로그의 스토어 열기용).
APP_STORE_ID=
# E2E 빌드 전용 fixture idToken. 배포 빌드에는 비워 둔다.
E2E_KAKAO_ID_TOKEN=
