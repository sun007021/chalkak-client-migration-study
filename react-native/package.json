{
  "name": "chalkak-rn",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-seoul/kakao-login": "6.0.4",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.19",
    "expo-constants": "^58.0.13",
    "expo-crypto": "58.0.7",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "3.9.10",
    "react-test-renderer": "^19.3.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:tz",
    "test:tz": "for tz in America/Los_Angeles Pacific/Kiritimati Pacific/Pago_Pago UTC Asia/Seoul; do TZ=$tz jest src/core/time || exit 1; done",
    "format:check": "prettier --check .",
    "coverage:tc": "node ../shared/scripts/check-tc-coverage.mjs react-native",
    "check:testids": "node ../shared/scripts/check-testids.mjs react-native"
  },
  "private": true,
  "engines": {
    "node": ">=22 <23"
  }
}
